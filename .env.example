# Copy to .env locally. Never commit real credentials.
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000
DATABASE_URL=postgresql://gigbid:gigbid_local_only@127.0.0.1:5432/gigbid
POSTGRES_USER=gigbid
POSTGRES_PASSWORD=gigbid_local_only
POSTGRES_DB=gigbid
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
MODEL_CACHE_DIR=work/models
HF_HOME=work/hf-cache
GIGBID_TENANT_ID=
MARKETPLACE_MODE=gigsim
STUDENT_SIM_URL=http://127.0.0.1:8080
STUDENT_SIM_API_KEY=student_sim_local_only
# Optional explicit JSON path; otherwise uses prepared data if present, synthetic jobs if absent.
STUDENT_SIM_CATALOGUE=
STUDENT_SIM_DATABASE=work/student-sim.sqlite
STUDENT_SIM_CLIENT_MODE=rule
# llm uses simulator/client_config.yaml and OLLAMA_BASE_URL, without paid API credentials.
GIGSIM_URL=http://localhost:8080
GIGSIM_TOKEN=
GIGSIM_IMAGE=
PORTFOLIO_MCP_URL=http://localhost:8101/mcp
MARKETPLACE_MCP_URL=http://localhost:8102/mcp
WORKSPACE_MCP_URL=http://localhost:8103/mcp
MCP_BEARER_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_TOKEN=
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
OAUTH_ENCRYPTION_KEY=
SESSION_SECRET=
COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=168
MODEL_PROFILE=open
GROQ_API_KEY=
# Local accounting allowance per model/day, not a provider quota or billing guarantee.
GROQ_DAILY_TOKEN_CAP=200000
# Optional: MODEL_PROFILE=hosted_open uses Groq open-weight models.
OLLAMA_BASE_URL=http://127.0.0.1:11434
WORKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional hosted models; selecting the open profile still requires open weights.
GOOGLE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=GigBid-A2
# Explicit metadata-only audit export; no prompts, CV text or tool arguments/results.
TRACE_EXPORT_ENABLED=false
